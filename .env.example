# Número de WhatsApp comercial (solo dígitos, código de país incluido, sin "+").
# Si no se define, se usa el valor por defecto ya presente en el sitio: 56989995290
NEXT_PUBLIC_WHATSAPP_NUMBER=56989995290

# Correo comercial usado en los botones de contacto directo.
# Si no se define, se usa el valor por defecto ya presente en el sitio: contacto@tecdex.net
NEXT_PUBLIC_COMMERCIAL_EMAIL=contacto@tecdex.net

# --- Google Analytics 4 -------------------------------------------------------
# Measurement ID del stream de isos.tecdex.net (formato G-XXXXXXXXXX).
# Se usa en dos lugares y DEBE ser el mismo en ambos:
#   1. layout.tsx, para cargar gtag.js en el navegador.
#   2. /go/whatsapp, para leer la cookie `_ga_<ID sin G->` y enviar el evento
#      whatsapp_click por Measurement Protocol dentro de la sesión existente.
GA4_MEASUREMENT_ID=

# Secreto de Measurement Protocol (GA4 > Admin > Data Streams > Measurement
# Protocol API secrets). Sólo servidor: nunca debe llevar prefijo NEXT_PUBLIC_
# ni aparecer en el bundle del cliente, en logs ni en el repositorio.
GA4_API_SECRET=
